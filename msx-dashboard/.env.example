# Copy this file to `.env` and fill in real values once you have MSX API access.
# Leave MSX_MODE=mock to run the viewer with sample data (no credentials needed).

MSX_MODE=mock
# MSX_MODE=live

# --- Only needed when MSX_MODE=live ---
# Dynamics 365 / MSX org base URL, e.g. https://yourorg.crm.dynamics.com
MSX_ORG_URL=

# Azure AD app registration used for service-to-service (client credentials) auth
MSX_TENANT_ID=
MSX_CLIENT_ID=
MSX_CLIENT_SECRET=

# The schema name of the TPID field on the Account entity in MSX (confirm with your MSX admin)
MSX_TPID_FIELD=msp_tpid

# The TPID we want this viewer to display (Alberta Health Services)
MSX_TARGET_TPID=5684700
