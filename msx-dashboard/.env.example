# Copy this file to `.env` and fill in real values once you have MSX API access.
# Leave MSX_MODE=mock to run the viewer with sample data (no credentials needed).

MSX_MODE=mock
# MSX_MODE=live

# --- Only needed when MSX_MODE=live ---
# Dynamics 365 / MSX org base URL (confirmed from your MSX Customer 360 view link)
MSX_ORG_URL=https://microsoftsales.crm.dynamics.com

# Auth mode: "device_code" (sign in as yourself, no app registration needed - default)
# or "client_credentials" (service-to-service, needs a full Azure AD app registration + secret)
MSX_AUTH_MODE=device_code

# --- device_code mode ---
# Leave blank to use Microsoft's own pre-consented "Azure PowerShell" public client.
# Only set these if that default doesn't work in your tenant.
MSX_TENANT_ID=organizations
MSX_CLIENT_ID=

# --- client_credentials mode only ---
MSX_CLIENT_SECRET=

# The entity set + TPID field confirmed from the MSX Customer 360 view URL
MSX_ENTITY_SET=msp_customer360s
MSX_TPID_FIELD=msp_tpid

# The TPID we want this viewer to display (Alberta Health Services)
MSX_TARGET_TPID=5684700
